{
  "name": "aethera",
  "version": "0.1.0",
  "description": "Live Airspace Intelligence",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/setup.mjs --infra",
    "dev": "pnpm --parallel --filter @aethera/web --filter @aethera/api --filter @aethera/ingestion dev",
    "dev:web": "pnpm --filter @aethera/web dev",
    "dev:api": "pnpm --filter @aethera/api dev",
    "dev:ingestion": "pnpm --filter @aethera/ingestion dev",
    "dev:infra": "node scripts/setup.mjs --infra",
    "build": "pnpm -r build",
    "start": "pnpm -r start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "migrate": "pnpm --filter @aethera/ingestion migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
