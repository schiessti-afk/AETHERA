# --- OpenSky REST API (ingestion only; never expose to the browser) ---
# Standard tier: 4,000 /states credits per day (independent of /tracks and /flights).
# Global /states/all costs 4 credits. Default poll is ~90s so the budget lasts 24h.
# Optional bbox (≤25 sq°) costs 1 credit and can poll faster. See docs/ARCHITECTURE.md §25.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_DAILY_CREDITS=4000
OPENSKY_POLL_INTERVAL_MS=90000
# OPENSKY_WEST=-10
# OPENSKY_SOUTH=35
# OPENSKY_EAST=30
# OPENSKY_NORTH=60

# --- Redis (host port 6380; container still listens on 6379) ---
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380

# --- PostgreSQL (host port 55432; container still listens on 5432) ---
DATABASE_URL=postgres://aethera:aethera_password@localhost:55432/aethera
POSTGRES_DB=aethera
POSTGRES_USER=aethera
POSTGRES_PASSWORD=aethera_password
POSTGRES_PORT=55432

# --- API ---
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Optional MapLibre style. Defaults to OpenFreeMap dark (free, no API key).
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
